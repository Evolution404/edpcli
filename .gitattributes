# Windows checkout cannot rewrite evidence bytes and invalidate SHA-256 proofs.
audit/protocol/lba7_compatibility/*.tsv text eol=lf
audit/protocol/lba7_compatibility/*.md text eol=lf
audit/protocol/lba7_compatibility/**/*.json text eol=lf
audit/protocol/lba7_compatibility/**/*.tsv text eol=lf
audit/protocol/lba7_compatibility/**/*.md text eol=lf
